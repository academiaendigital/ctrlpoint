# Panel CTRL+ · reglas para HostGator (Apache). Sustituye las de la tienda en esta carpeta.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteRule (^|/)\. - [F]
  RewriteRule ^app(/|$) - [F]
  RewriteRule \.(sql|bak|env|ini|log|md|json|lock|dist)$ - [F,NC]
</IfModule>

<IfModule mod_headers.c>
  # Reemplaza la política de la tienda (que bloquea formularios) por la del panel
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header unset X-Powered-By
</IfModule>

<IfModule mod_php.c>
  php_flag display_errors off
  php_flag expose_php off
</IfModule>
